#!/usr/bin/env bash
# Run multiple subagent (LLM) calls in parallel.
# Usage: subagent_batch '<json array of prompts>' [--system 'system prompt']

json="$1"
if [[ -z "$json" ]]; then echo "usage: subagent_batch '<json array>' [--system 'prompt']" >&2; exit 2; fi
shift

# Collect remaining args (e.g. --system "...")
extra_args=("$@")

batchdir=$(mktemp -d)
pids=()
i=0

while IFS= read -r prompt; do
  ( subagent "$prompt" "${extra_args[@]}" > "$batchdir/$i.out" 2>"$batchdir/$i.err" ) &
  pids+=($!)
  i=$((i + 1))
done < <(printf '%s' "$json" | jq -r '.[]')

total=$i
for pid in "${pids[@]}"; do wait "$pid"; done

succeeded=0
failed=0
for ((j=0; j<total; j++)); do
  printf '── Agent %d/%d ──\n' "$((j + 1))" "$total" >&2
  out=$(cat "$batchdir/$j.out")
  err=$(cat "$batchdir/$j.err")
  if [[ -n "$out" ]]; then
    printf '  %s\n' "$out" >&2
    printf '%s\n' "$out"
    succeeded=$((succeeded + 1))
  elif [[ -n "$err" ]]; then
    printf '  [error] %s\n' "$err" >&2
    printf '[error] %s\n' "$err"
    failed=$((failed + 1))
  else
    printf '  [no output]\n' >&2
    printf '[no output]\n'
    failed=$((failed + 1))
  fi
done
printf '── %d/%d agents completed ──\n' "$succeeded" "$total" >&2
rm -rf "$batchdir"
