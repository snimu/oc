#!/usr/bin/env bash
# Spawn a full OpenCode child session with tool access.
# Creates a child session (visible in Ctrl-X), sends the prompt,
# polls until idle, and returns the last assistant message.
#
# Talks to the local proxy server started by the plugin, which
# forwards requests to the OpenCode SDK client.
#
# Usage: subagent '<prompt>'

prompt="$1"
if [[ -z "$prompt" ]]; then echo "usage: subagent '<prompt>'" >&2; exit 2; fi

# Read session ID written by tool.execute.before
session_id=""
if [[ -n "$OPENCODE_RLM_SESSION_ID_FILE" && -f "$OPENCODE_RLM_SESSION_ID_FILE" ]]; then
  session_id=$(cat "$OPENCODE_RLM_SESSION_ID_FILE")
fi
if [[ -z "$session_id" ]]; then
  echo "subagent: no session ID available (OPENCODE_RLM_SESSION_ID_FILE not set or empty)" >&2
  exit 1
fi

H="content-type: application/json"

# 1. Create child session (parentID links it to the current session → visible in Ctrl-X)
sess=$(curl -sS -X POST "$OPENCODE_RLM_URL/session" \
  -H "$H" \
  -H "x-opencode-directory: $OPENCODE_RLM_DIR_PATH" \
  -d "{\"parentID\":\"$session_id\"}")
sid=$(printf '%s' "$sess" | jq -r '.id')
if [[ -z "$sid" || "$sid" == "null" ]]; then
  echo "subagent: failed to create session: $sess" >&2
  exit 1
fi

# 2. Send prompt (async — returns immediately)
curl -sS -X POST "$OPENCODE_RLM_URL/session/$sid/prompt_async" \
  -H "$H" \
  -H "x-opencode-directory: $OPENCODE_RLM_DIR_PATH" \
  -d "{\"parts\":[{\"type\":\"text\",\"text\":$(printf '%s' "$prompt" | jq -Rs .)}],\"agent\":\"general\"}" \
  >/dev/null

# 3. Poll status until idle
while true; do
  _status=$(curl -sS "$OPENCODE_RLM_URL/session/status" \
    -H "x-opencode-directory: $OPENCODE_RLM_DIR_PATH" \
    | jq -r ".\"$sid\".type // \"idle\"")
  if [[ "$_status" != "busy" ]]; then break; fi
  sleep 0.5
done

# 4. Read last assistant message
msgs=$(curl -sS "$OPENCODE_RLM_URL/session/$sid/message" \
  -H "x-opencode-directory: $OPENCODE_RLM_DIR_PATH")
printf '%s' "$msgs" | jq -r '[.[] | select(.info.role=="assistant")] | last | .parts[] | select(.type=="text") | .text'
